# Copie para .env e preencha:  cp .env.example .env

# Token do bot, gerado no @BotFather
BOT_TOKEN=123456:ABC-seu-token-aqui

# IDs do Telegram dos admins, separados por vírgula (descubra o seu com o @userinfobot)
ADMIN_ID=111111111,222222222

# Senha compartilhada entre o bot e a API (header X-API-Token).
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=troque-isto

# Opcionais
# API_URL=http://127.0.0.1:8000      # no Docker é sobrescrito para http://api:8000
# DB_PATH=data/topazio.db
